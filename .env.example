# Kafka: container-internal address. Host tools use KAFKA_BOOTSTRAP_HOST (set by the Makefile).
KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_CLUSTER_ID=MkU3OEVBNzcwNTJENDM2Qk

# TimescaleDB
POSTGRES_USER=parking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=parking
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# Stream processor (seconds)
WINDOW_SIZE_S=300
ALLOWED_LATENESS_S=60
WINDOW_GRACE_S=120
DEDUPE_TTL_S=300
EMIT_INTERVAL_S=5
CHECKPOINT_INTERVAL_S=10
SENSOR_OFFLINE_AFTER_S=120
PROCESSOR_METRICS_PORT=8000

# Alerter
ALERT_FULL_THRESHOLD=0.90
ALERT_CLEAR_THRESHOLD=0.85
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Simulator
SIM_LOTS=12
SIM_SLOTS_PER_LOT=60
SIM_SPEED=20
SIM_START_HOUR=6
SIM_SALT=change-me-too

# API gateway (comma-separated browser origins allowed to call it)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
